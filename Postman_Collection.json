{
  "info": {
    "name": "Flight Booking API - Duffel Integration",
    "description": "API Collection cho hệ thống đặt vé máy bay tích hợp Duffel",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://bookingflightticket-backend-new.onrender.com",
      "type": "string"
    },
    {
      "key": "local_url",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Tìm kiếm chuyến bay",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/client/chuyen-bay?maSanBayDi=HAN&maSanBayDen=SGN&ngayBay=2026-05-01&adults=1",
          "host": ["{{base_url}}"],
          "path": ["api", "client", "chuyen-bay"],
          "query": [
            {
              "key": "maSanBayDi",
              "value": "HAN",
              "description": "Mã IATA sân bay đi (VD: HAN, SGN, LHR)"
            },
            {
              "key": "maSanBayDen",
              "value": "SGN",
              "description": "Mã IATA sân bay đến (VD: SGN, HAN, JFK)"
            },
            {
              "key": "ngayBay",
              "value": "2026-05-01",
              "description": "Ngày bay (YYYY-MM-DD)"
            },
            {
              "key": "adults",
              "value": "1",
              "description": "Số người lớn (mặc định: 1)"
            }
          ]
        },
        "description": "Tìm kiếm chuyến bay từ Duffel API, giá tự động quy đổi sang VND"
      },
      "response": []
    },
    {
      "name": "2. Danh sách sân bay",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/client/san-bay?search=hanoi",
          "host": ["{{base_url}}"],
          "path": ["api", "client", "san-bay"],
          "query": [
            {
              "key": "search",
              "value": "hanoi",
              "description": "Tìm kiếm theo tên hoặc mã sân bay"
            }
          ]
        },
        "description": "Lấy danh sách sân bay từ Duffel API (dùng cho autocomplete)"
      },
      "response": []
    },
    {
      "name": "3. Danh sách hãng hàng không",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/client/hang-hang-khong?search=vietnam",
          "host": ["{{base_url}}"],
          "path": ["api", "client", "hang-hang-khong"],
          "query": [
            {
              "key": "search",
              "value": "vietnam",
              "description": "Tìm kiếm theo tên hoặc mã hãng"
            }
          ]
        },
        "description": "Lấy danh sách hãng hàng không từ Duffel API"
      },
      "response": []
    },
    {
      "name": "4. Tạo đơn hàng (Đặt vé)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"offer_data\": {\n    \"duffel_offer_id\": \"off_0000AZJlYKzG4Y8NAjmfDr\",\n    \"gia_thap_nhat\": 2500000,\n    \"hang_hang_khong\": {\n      \"tenHang\": \"Vietnam Airlines\",\n      \"logo\": \"https://...\",\n      \"maCode\": \"VN\"\n    },\n    \"san_bay_di\": {\n      \"maCode\": \"HAN\",\n      \"tenSanBay\": \"Hanoi\"\n    },\n    \"san_bay_den\": {\n      \"maCode\": \"SGN\",\n      \"tenSanBay\": \"Ho Chi Minh City\"\n    },\n    \"ngayGioCatCanh\": \"2026-05-01T08:00:00\",\n    \"ngayGioHaCanh\": \"2026-05-01T10:00:00\"\n  },\n  \"hanh_khach\": [\n    {\n      \"hoTen\": \"Nguyen Van A\",\n      \"ho\": \"Nguyen\",\n      \"ten\": \"Van A\",\n      \"ngaySinh\": \"1990-01-01\",\n      \"gioiTinh\": \"Nam\",\n      \"loaiHanhKhach\": \"NguoiLon\",\n      \"soHoChieu\": \"ABC123456\",\n      \"soCMND\": \"123456789\",\n      \"email\": \"test@example.com\",\n      \"sdt\": \"0123456789\"\n    }\n  ],\n  \"thongTinLienHe\": {\n    \"ten\": \"Nguyen Van A\",\n    \"email\": \"test@example.com\",\n    \"sdt\": \"0123456789\"\n  },\n  \"phuongThucThanhToan\": \"VNPAY\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/client/dat-ve/tao-don-hang",
          "host": ["{{base_url}}"],
          "path": ["api", "client", "dat-ve", "tao-don-hang"]
        },
        "description": "Tạo đơn hàng từ offer đã chọn. LƯU Ý: offer_data phải lấy từ API tìm kiếm chuyến bay"
      },
      "response": []
    },
    {
      "name": "5. Danh sách đơn hàng",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/client/dat-ve/don-hang?trangThai=1&perPage=10",
          "host": ["{{base_url}}"],
          "path": ["api", "client", "dat-ve", "don-hang"],
          "query": [
            {
              "key": "trangThai",
              "value": "1",
              "description": "0=Chờ thanh toán, 1=Đã thanh toán, 2=Đã xác nhận, 3=Đã hủy"
            },
            {
              "key": "perPage",
              "value": "10",
              "description": "Số bản ghi mỗi trang"
            }
          ]
        },
        "description": "Xem danh sách đơn hàng (của user nếu đã đăng nhập)"
      },
      "response": []
    },
    {
      "name": "6. Chi tiết đơn hàng",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/client/dat-ve/don-hang/1",
          "host": ["{{base_url}}"],
          "path": ["api", "client", "dat-ve", "don-hang", "1"]
        },
        "description": "Xem chi tiết đơn hàng theo ID"
      },
      "response": []
    },
    {
      "name": "7. Danh sách vé",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/client/dat-ve/ve?trangThaiVe=DaDat&perPage=10",
          "host": ["{{base_url}}"],
          "path": ["api", "client", "dat-ve", "ve"],
          "query": [
            {
              "key": "trangThaiVe",
              "value": "DaDat",
              "description": "DaDat, DaHuy"
            },
            {
              "key": "perPage",
              "value": "10",
              "description": "Số bản ghi mỗi trang"
            }
          ]
        },
        "description": "Xem danh sách vé đã đặt"
      },
      "response": []
    },
    {
      "name": "8. Hủy đơn hàng",
      "request": {
        "method": "PUT",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/client/dat-ve/don-hang/1/huy",
          "host": ["{{base_url}}"],
          "path": ["api", "client", "dat-ve", "don-hang", "1", "huy"]
        },
        "description": "Hủy đơn hàng (chỉ được hủy đơn chưa thanh toán)"
      },
      "response": []
    },
    {
      "name": "9. Danh sách khuyến mãi",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/client/khuyen-mai",
          "host": ["{{base_url}}"],
          "path": ["api", "client", "khuyen-mai"]
        },
        "description": "Xem danh sách khuyến mãi đang hoạt động"
      },
      "response": []
    }
  ]
}
